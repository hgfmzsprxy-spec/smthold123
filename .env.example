# Server-only. Required so guests can load STATUS / VERSION / LAST-UPDATE from applications
# (anon key is blocked by RLS). Paste from Supabase → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: Discord snowflake(s) allowed into /admin (comma-separated).
# Default owner ID is also baked into lib/admin-auth.js.
ADMIN_DISCORD_ID=
ADMIN_DISCORD_IDS=
NEXT_PUBLIC_DISABLE_SITE_PROTECTION=
NEXT_PUBLIC_LOADER_APP_ID_CALL_OF_DUTY=c3712051cd0d8efe
NEXT_PUBLIC_LOADER_APP_ID_APEX_LEGENDS=2b635880eaad98a4
NEXT_PUBLIC_LOADER_APP_ID_TEMPORARY_SPOOFER=9eda42f5237ca930
NEXT_PUBLIC_LOADER_APP_ID_KBM_AIM_ASSIST=c431f619947d6858
NEXT_PUBLIC_KOMERZA_STORE_ID=b04731ef-b34c-413f-bead-1d10d35a5888
# Reseller Store (SellAuth embed). Shop ID is public (used client-side).
# https://docs.sellauth.com/guides/embed
NEXT_PUBLIC_SELLAUTH_SHOP_ID=255364
# Supabase project region (shown in Response time monitor). e.g. eu-west-1 (Ireland)
SUPABASE_REGION=
# AI Support (/ai-support) — free by default via Groq
# Get a free key: https://console.groq.com/keys
GROQ_API_KEY=
# Optional model (default: openai/gpt-oss-20b)
# AI_SUPPORT_MODEL=openai/gpt-oss-20b
# Vision model used when a screenshot is attached (default: meta-llama/llama-4-scout-17b-16e-instruct)
# AI_SUPPORT_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Voice notes transcription (default: whisper-large-v3-turbo)
# AI_SUPPORT_WHISPER_MODEL=whisper-large-v3-turbo
# Alternatives: openai/gpt-oss-120b , qwen/qwen3.6-27b
# Paid OpenAI fallback (only if you want it instead of Groq):
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
